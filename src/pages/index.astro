---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SceneBackground from '../components/SceneBackground';
import SmoothScroll from '../components/SmoothScroll';
import Nav from '../components/Nav';
import Hero from '../components/Hero';
import Profile from '../components/Profile';
import Recognition from '../components/Recognition';
import Experience from '../components/Experience';
import Projects from '../components/Projects';
import Contact from '../components/Contact';
import { profile, links } from '../data/site';
import fondo from '../assets/fondo.jpg';
import retrato from '../assets/avatar-humation.png';
import fondoLetra from '../assets/fondo-letra.jpg';
import capturaFullstack from '../assets/fullstack.jpg';
import capturaFrontend from '../assets/frotend.jpg';

// La escena WebGL consume una textura optimizada, no el JPG original.
const sceneImage = await getImage({ src: fondo, width: 1600, format: 'webp', quality: 76 });

// Pieza del titular del hero: va chica, así alcanzan dos anchos livianos.
const photoWidths = [600, 1200];
const photoSources = await Promise.all(
  photoWidths.map((width) => getImage({ src: fondoLetra, width, format: 'webp', quality: 80 })),
);
const photo = {
  src: photoSources[0].src,
  srcSet: photoSources.map((v, i) => `${v.src} ${photoWidths[i]}w`).join(', '),
};

// Las dos capturas que van dentro de las píldoras del titular: chicas en
// pantalla, así con dos anchos livianos alcanza.
const shotWidths = [320, 640];
const buildShot = async (src: ImageMetadata) => {
  const sources = await Promise.all(
    shotWidths.map((width) => getImage({ src, width, format: 'webp', quality: 78 })),
  );
  return {
    src: sources[0].src,
    srcSet: sources.map((v, i) => `${v.src} ${shotWidths[i]}w`).join(', '),
  };
};
const shotFullstack = await buildShot(capturaFullstack);
const shotFrontend = await buildShot(capturaFrontend);

// Retrato de la tarjeta de perfil, en dos densidades.
const portraitWidths = [240, 480];
const portraitSources = await Promise.all(
  portraitWidths.map((width) => getImage({ src: retrato, width, format: 'webp', quality: 82 })),
);
const portrait = {
  src: portraitSources[0].src,
  srcSet: portraitSources.map((v, i) => `${v.src} ${portraitWidths[i]}w`).join(', '),
  width: 240,
  height: 240,
};

// Banda de cierre, sobre Contacto: el paisaje verde en dos anchos.
const groundWidths = [900, 1800];
const ground = await Promise.all(
  groundWidths.map((width) => getImage({ src: fondo, width, format: 'webp', quality: 74 })),
);
const foreground = {
  src: ground[1].src,
  srcSet: ground.map((v, i) => `${v.src} ${groundWidths[i]}w`).join(', '),
};

const year = new Date().getFullYear();
---

<Layout>
  <SceneBackground
    texture={sceneImage.src}
    textureWidth={1600}
    textureHeight={Math.round((1600 * fondo.height) / fondo.width)}
    client:load
  />

  <Nav avatar={portrait.src} client:load />
  <SmoothScroll client:load />

  <main id="contenido" class="relative">
    <Hero
      photo={photo}
      portrait={portrait}
      fullstack={shotFullstack}
      frontend={shotFrontend}
      client:load
    />
    <Profile portrait={portrait} client:visible />
    <Recognition client:visible />
    <Experience client:visible />
    {/* client:load a propósito: el pin horizontal debe existir antes de
        que el usuario llegue, o la altura del documento salta al hidratar. */}
    <Projects client:load />
    <Contact closing={foreground} client:visible />
  </main>

  <footer class="shell relative flex flex-col gap-4 border-t border-[var(--rule)] py-10 text-sm text-[var(--fg-faint)] sm:flex-row sm:items-center sm:justify-between">
    <p>
      © <span class="tnum">{year}</span> {profile.fullName}
    </p>
    <p class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <span>Astro · React · Three.js · GSAP · Lenis</span>
      <a
        href={links.github}
        target="_blank"
        rel="noreferrer"
        class="underline decoration-[var(--rule)] transition-colors duration-200 hover:text-[var(--accent)]"
      >
        Código
      </a>
    </p>
  </footer>
</Layout>
