---
import Layout from '../layouts/Layout.astro';
import StaggeredNavbar from '../components/StaggeredNavbar';
import HeroScrollExpand from '../components/HeroScrollExpand';
import AboutSection from '../components/AboutSection';
---

<Layout title="Mauricio Heredia | Portafolio Creativo 2026">
  <!-- Navbar maestro unificado centrado con Avatar, Menu y Theme Toggle -->
  <StaggeredNavbar client:load />

  <main class="relative z-10 w-full min-h-screen flex flex-col justify-between selection:bg-[#00D26A] selection:text-black transition-colors duration-400">
    
    <!-- Hero Section -->
    <HeroScrollExpand client:load />

    <!-- Sección 02: Sobre Mí (Apple Bento Grid + Hugeicons + Glassmorphism) -->
    <AboutSection client:visible />

    <!-- Footer Moderno -->
    <footer class="max-w-7xl mx-auto w-full px-6 sm:px-12 md:px-16 py-12 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 text-xs text-zinc-500 tracking-wider border-t border-black/10 dark:border-white/10 transition-colors">
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#00D26A]" title="Verde Fuerte"></span>
          <span class="w-3 h-3 rounded-full bg-[#0052FF]" title="Azul Fuerte"></span>
          <span class="w-3 h-3 rounded-full bg-[#F9F6EE] border border-black/20" title="Estilo Crema"></span>
          <span class="w-3 h-3 rounded-full bg-black border border-white/20" title="Negro"></span>
        </div>
        <span class="text-zinc-400 dark:text-zinc-600">|</span>
        <span>Astro + React + GSAP + Three.js</span>
      </div>
      <p class="font-medium text-zinc-600 dark:text-zinc-400">
        Diseñado & Desarrollado con 💚 por Mauricio Heredia
      </p>
    </footer>

  </main>
</Layout>