---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mauricio Heredia | Portafolio">
  <main class="min-h-screen w-full bg-[#080808] text-[#F9F6EE] flex flex-col justify-between p-8 md:p-16 selection:bg-[#00D26A] selection:text-black">
    
    <!-- Top Header -->
    <header class="flex justify-between items-center text-xs tracking-[0.3em] uppercase text-zinc-500 font-medium">
      <span class="text-[#00D26A] font-semibold">Mauricio Heredia</span>
      <span>Frontend Developer</span>
      <span class="hidden sm:inline">2026</span>
    </header>

    <!-- Center Hero -->
    <section class="my-auto py-20 flex flex-col items-start justify-center">
      <div class="inline-flex items-center gap-3 px-3 py-1 rounded-full border border-white/10 bg-white/[0.02] mb-6">
        <span class="w-2 h-2 rounded-full bg-[#0052FF] animate-pulse"></span>
        <span class="text-[11px] font-medium tracking-widest uppercase text-zinc-400">Empezando de 0</span>
      </div>
      
      <h1 class="text-[14vw] md:text-[11vw] font-black uppercase tracking-tighter leading-[0.85] text-[#F9F6EE]">
        PORTAFOLIO
      </h1>
    </section>

    <!-- Bottom Footer -->
    <footer class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-xs text-zinc-500 tracking-wider">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-[#00D26A]" title="Verde Fuerte"></span>
        <span class="w-3 h-3 rounded-full bg-[#0052FF]" title="Azul Fuerte"></span>
        <span class="w-3 h-3 rounded-full bg-[#F9F6EE]" title="Estilo Crema"></span>
        <span class="w-3 h-3 rounded-full bg-black border border-white/20" title="Negro"></span>
      </div>
      <p class="font-light">Listo para el nuevo diseño</p>
    </footer>

  </main>
</Layout>