---
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = `${profile.role} especializado en ${profile.specialty}. Angular, Next.js, React, Astro y TypeScript, con animación en GSAP. ${profile.location}, remoto.`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://mauricioheredia.dev');
const ogImage = new URL('/og.jpg', canonical);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_AR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@1,6..72,300..500&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: profile.fullName,
        jobTitle: profile.role,
        url: canonical.href,
        address: { '@type': 'PostalAddress', addressLocality: 'Formosa', addressCountry: 'AR' },
        sameAs: ['https://github.com/mau-jsx', 'https://www.linkedin.com/in/mauricio-heredia-dev'],
      })}
    />

    <script is:inline>
      // Antes de pintar: el sitio va siempre en claro y en el idioma guardado.
      // Los textos fijos (con data-es / data-en) se cambian apenas existen.
      (function () {
        var root = document.documentElement;
        root.classList.remove('dark');
        root.style.colorScheme = 'light';
        var lang = null;
        try { lang = localStorage.getItem('lang'); } catch (e) {}
        if (lang !== 'en') return;
        root.lang = 'en';
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('[data-en]').forEach(function (el) {
            el.textContent = el.getAttribute('data-en');
          });
        });
      })();
    </script>
  </head>

  <body>
    <a
      href="#contenido"
      data-es="Saltar al contenido"
      data-en="Skip to content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-[var(--fg)] focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-[var(--bg)]"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
