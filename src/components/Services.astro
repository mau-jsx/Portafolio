---
import { Bot, Zap, ArrowUpRight, Sparkles, Layout, Database } from 'lucide-react';
import logoRincon from '../assets/logo-blanco.webp';

const phoneNumber = "3705022130";

const getWhatsAppLink = (service: string) => {
  const message = encodeURIComponent(`¡Hola Mauricio! Me interesa el servicio de: ${service}`);
  return `https://wa.me/${phoneNumber}?text=${message}`;
};
---

<section id="services" class="relative bg-[#080808] py-32 border-t border-white/5 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    
    <div class="flex flex-col gap-10 mb-24">
      <div class="flex items-center gap-4">
        <span class="text-[#C1FF00] font-mono text-xs uppercase tracking-[0.5em]">03. Servicios</span>
        <div class="h-px w-20 bg-white/10"></div>
      </div>
      <h2 class="text-6xl md:text-8xl font-['Archivo_Black'] text-white uppercase italic leading-[0.8] tracking-tighter">
        DOS MUNDOS, <br/> <span class="text-zinc-800">UN OBJETIVO.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <div class="group relative bg-zinc-900/40 border border-white/10 rounded-[3.5rem] p-8 md:p-12 overflow-hidden transition-all duration-700 hover:border-[#C1FF00]/40">
        <div class="absolute top-0 right-0 p-8 opacity-10 group-hover:opacity-100 transition-opacity">
           <img src={logoRincon.src} alt="Rincón Digital" class="w-24 md:w-32" />
        </div>
        
        <div class="relative z-10">
          <span class="bg-white/10 text-white text-[10px] font-black px-4 py-2 rounded-full uppercase tracking-widest">Emprendimiento</span>
          <h3 class="text-4xl md:text-5xl font-['Archivo_Black'] text-white uppercase italic mt-8 mb-6 leading-none">Rincón <br/> Digital</h3>
          <p class="text-zinc-500 max-w-sm mb-10 text-sm md:text-base italic">Digitalizamos comercios locales con sistemas de IA, menús inteligentes y sitios web de alto impacto para negocios de Formosa.</p>
          
          <ul class="space-y-4 mb-12">
            <li class="flex items-center gap-3 text-zinc-300 text-sm uppercase font-bold tracking-tighter">
              <Layout size={18} className="text-[#C1FF00]" /> Páginas Web para Locales
            </li>
            <li class="flex items-center gap-3 text-zinc-300 text-sm uppercase font-bold tracking-tighter">
              <Database size={18} className="text-[#C1FF00]" /> Sistemas de Gestión
            </li>
          </ul>

          <a href={getWhatsAppLink("Rincón Digital - Consulta")} class="inline-flex items-center gap-4 bg-white text-black px-8 py-4 rounded-full font-black uppercase text-xs hover:bg-[#C1FF00] transition-colors">
            Contactar Agencia <ArrowUpRight size={18} />
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-8">
        <div class="bg-zinc-900/20 border border-white/5 rounded-[3rem] p-10 hover:bg-zinc-900/40 transition-all group">
          <div class="flex justify-between items-start mb-6">
            <Bot className="text-[#C1FF00]" size={32} />
            <a href={getWhatsAppLink("IA & LLM Ops")}><ArrowUpRight className="text-zinc-700 group-hover:text-white" /></a>
          </div>
          <h4 class="text-2xl font-black text-white uppercase italic tracking-tighter">AI & LLM Ops</h4>
          <p class="text-zinc-500 text-sm mt-2">Consultoría personalizada para integrar modelos de lenguaje y agentes autónomos.</p>
        </div>

        <div class="bg-zinc-900/20 border border-white/5 rounded-[3rem] p-10 hover:bg-zinc-900/40 transition-all group">
          <div class="flex justify-between items-start mb-6">
            <Zap className="text-[#C1FF00]" size={32} />
            <a href={getWhatsAppLink("Automatización n8n")}><ArrowUpRight className="text-zinc-700 group-hover:text-white" /></a>
          </div>
          <h4 class="text-2xl font-black text-white uppercase italic tracking-tighter">n8n Workflow</h4>
          <p class="text-zinc-500 text-sm mt-2">Automatización de procesos empresariales complejos y conexión de APIs.</p>
        </div>

        <div class="bg-[#C1FF00] rounded-[3rem] p-10 flex items-center justify-between group cursor-pointer overflow-hidden relative">
          <div class="relative z-10">
            <h4 class="text-3xl font-['Archivo_Black'] text-black uppercase italic leading-none tracking-tighter">¿Hablamos <br/> directo?</h4>
          </div>
          <a href={getWhatsAppLink("Consulta Personal Directa")} class="relative z-10 w-16 h-16 bg-black rounded-full flex items-center justify-center text-[#C1FF00] hover:scale-110 transition-transform">
            <Sparkles size={24} />
          </a>
          <Sparkles className="absolute -right-4 -bottom-4 text-black/5" size={120} />
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Efecto de ruido sutil para las tarjetas */
  .group::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("https://grainy-gradients.vercel.app/noise.svg");
    opacity: 0.03;
    pointer-events: none;
  }
</style>