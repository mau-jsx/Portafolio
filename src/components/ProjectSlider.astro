---
import donMiguelImg from '../assets/Don-Miguel.jpg';
import piaxionImg from '../assets/Piaxion.jpg';
import antonella from "../assets/Antonella.webp";
import mariano from "../assets/Mariano.jpg";
import Mauricio from "../assets/yo2.0.jpg";
import { ArrowUpRight } from 'lucide-react';

const projects = [
  { 
    id: "01", 
    title: "Bar Don Miguel", 
    description: "Gestión gastronómica integral con menú interactivo y pedidos vía WhatsApp.", 
    image: donMiguelImg.src, 
    link: "https://don-miguel-restaurante.vercel.app/", 
    color: "#00FF87", 
    team: [
      { name: "Mauricio", avatar: Mauricio.src, role: "Frontend UI", color: "#C1FF00" }, 
      { name: "Antonella", avatar: antonella.src, role: "Backend DB", color: "#FF00E5" }
    ] 
  },
  { 
    id: "02", 
    title: "Numa Math", 
    description: "Tutor inteligente de matemáticas con Chatbot adaptable y desafíos IA.", 
    image: piaxionImg.src, 
    link: "https://github.com/Final-Proyecto/Piaxion", 
    color: "#00E0FF", 
    team: [
      { name: "Mauricio", avatar: Mauricio.src, role: "Frontend Mobile", color: "#C1FF00" }, 
      { name: "Antonella", avatar: antonella.src, role: "Backend IA", color: "#FF00E5" }, 
      { name: "Mariano", avatar: mariano.src, role: "Mobile Dev", color: "#00E0FF" }
    ] 
  }
];
---

<section id="projects-pin" class="relative bg-[#080808] border-t border-white/5">
  <div class="relative w-full h-screen overflow-hidden">
    {projects.map((project, index) => (
      <div class={`project-scene absolute inset-0 w-full h-full grid grid-cols-1 lg:grid-cols-12 items-center px-6 lg:px-20 gap-10 ${index === 0 ? 'opacity-100' : 'opacity-0 invisible'}`} data-index={index}>
        
        <div class="lg:col-span-3 flex flex-col justify-center lg:h-full z-20">
            <div class="project-number mb-4 lg:mb-8">
                <span class="text-5xl lg:text-7xl font-['Archivo_Black'] text-white/10 italic tracking-tighter block leading-none">
                    {project.id}
                </span>
                <div class="h-1 w-12 bg-[#C1FF00] mt-2"></div>
            </div>
            
            <div class="project-title-wrapper">
                <h2 class="text-4xl lg:text-7xl font-['Archivo_Black'] text-white uppercase italic tracking-tighter leading-[0.8]">
                    {project.title.split(' ')[0]} <br/>
                    <span style={`color: ${project.color}`}>{project.title.split(' ').slice(1).join(' ')}</span>
                </h2>
            </div>
        </div>

        <div class="lg:col-span-6 flex justify-center z-10">
            <div class="project-image-container w-full aspect-video lg:aspect-auto lg:h-[55vh] overflow-hidden rounded-[2rem] border border-white/10 shadow-2xl relative">
                <img src={project.image} class="w-full h-full object-cover grayscale project-img scale-110" alt={project.title} />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
            </div>
        </div>

        <div class="lg:col-span-3 flex flex-col gap-6 lg:gap-8 z-20">
            <p class="project-description text-zinc-400 text-sm lg:text-base font-light italic leading-relaxed max-w-xs">
                {project.description}
            </p>

            <div class="project-team flex flex-col gap-4">
                <span class="text-[9px] uppercase tracking-[0.4em] text-zinc-600 font-black">Crew</span>
                <div class="flex flex-col gap-3">
                    {project.team.map((member) => (
                        <div class="flex items-center bg-white/5 border border-white/10 p-2 pr-5 rounded-full w-fit gap-3 group/member hover:border-white/20 transition-all">
                            <img 
                                src={member.avatar} 
                                alt={member.name} 
                                class="w-9 h-9 rounded-full object-cover transition-all duration-500"
                                style={`border: 2px solid ${member.color}`}
                            />
                            <div class="flex flex-col leading-none">
                                <span class="text-white text-[10px] font-black uppercase tracking-tight">{member.name}</span>
                                <span class="text-zinc-500 text-[8px] uppercase tracking-widest mt-1">{member.role}</span>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

            <a href={project.link} target="_blank" class="project-link mt-2 flex items-center gap-4 group w-fit">
                <div class="w-12 h-12 lg:w-14 lg:h-14 bg-[#C1FF00] rounded-full flex items-center justify-center group-hover:rotate-45 transition-all duration-500 shadow-xl">
                    <ArrowUpRight size={24} className="text-black" />
                </div>
                <span class="text-[10px] font-black uppercase tracking-widest text-white border-b border-white/10 pb-1 group-hover:text-[#C1FF00] group-hover:border-[#C1FF00] transition-all">Launch</span>
            </a>
        </div>

      </div>
    ))}
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const scenes = gsap.utils.toArray('.project-scene') as HTMLElement[];
  const totalDuration = scenes.length * window.innerHeight * 1.5;

  ScrollTrigger.create({
    trigger: "#projects-pin",
    pin: true,
    start: "top top",
    end: () => "+=" + totalDuration,
    scrub: 1,
  });

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#projects-pin",
      start: "top top",
      end: () => "+=" + totalDuration,
      scrub: 0.8,
    }
  });

  scenes.forEach((scene, i) => {
    const elements = [
      scene.querySelector('.project-number'),
      scene.querySelector('.project-title-wrapper'),
      scene.querySelector('.project-image-container'),
      scene.querySelector('.project-description'),
      scene.querySelector('.project-team'),
      scene.querySelector('.project-link')
    ];
    const projectImg = scene.querySelector('.project-img');

    if (i !== 0) {
        gsap.set(elements, { autoAlpha: 0, y: 50 });
    }

    if (i < scenes.length - 1) {
        tl.to(elements, { autoAlpha: 0, y: -50, stagger: 0.05, duration: 1 }, "+=0.5")
          
        const nextScene = scenes[i+1];
        const nextElements = [
          nextScene.querySelector('.project-number'),
          nextScene.querySelector('.project-title-wrapper'),
          nextScene.querySelector('.project-image-container'),
          nextScene.querySelector('.project-description'),
          nextScene.querySelector('.project-team'),
          nextScene.querySelector('.project-link')
        ];

        tl.fromTo(nextElements, 
            { autoAlpha: 0, y: 50 },
            { autoAlpha: 1, y: 0, stagger: 0.1, duration: 1, 
              onStart: () => { nextScene.style.visibility = 'visible'; nextScene.style.opacity = '1'; }
            }, "-=0.5"
        );
    } else {
        tl.to(scene, { duration: 1.2 });
    }

    gsap.to(projectImg, {
        y: -40,
        scrollTrigger: { trigger: scene, scrub: true }
    });
  });
</script>

<style>
  .project-scene { 
    will-change: transform, opacity; 
  }
  
  @media (max-width: 1024px) {
    .project-scene { 
      padding-top: 80px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      overflow-y: auto;
    }
    .project-image-container { 
      height: 25vh !important; 
      min-height: 200px;
    }
  }
</style>