---
import { Github, Linkedin, Instagram, ArrowUp, Zap } from 'lucide-react';
---

<footer class="relative bg-[#080808] pt-32 pb-12 overflow-hidden border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 mb-24">
      <div class="space-y-8">
        <h2 class="text-5xl md:text-7xl font-['Archivo_Black'] text-white uppercase italic leading-none tracking-tighter">
          VAMOS A <br/> <span class="text-[#C1FF00]">CONSTRUIR.</span>
        </h2>
        <p class="text-zinc-500 max-w-sm font-light italic leading-relaxed">
          Disponible para colaboraciones estratégicas y digitalización de negocios locales. 
          Basado en Formosa, Argentina para el mundo.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8">
        <div class="flex flex-col gap-4">
          <span class="text-[10px] font-black text-zinc-700 uppercase tracking-[0.3em]">Navegación</span>
          <a href="#hero" class="text-white/40 hover:text-white transition-colors uppercase text-xs font-bold italic">Inicio</a>
          <a href="#about" class="text-white/40 hover:text-white transition-colors uppercase text-xs font-bold italic">Sobre Mí</a>
          <a href="#projects-pin" class="text-white/40 hover:text-white transition-colors uppercase text-xs font-bold italic">Proyectos</a>
          <a href="#services" class="text-white/40 hover:text-white transition-colors uppercase text-xs font-bold italic">Servicios</a>
        </div>
        <div class="flex flex-col gap-4">
          <span class="text-[10px] font-black text-zinc-700 uppercase tracking-[0.3em]">Social</span>
          <a href="https://github.com/mau-jsx" target="_blank" class="text-white/40 hover:text-[#C1FF00] transition-colors uppercase text-xs font-bold italic">GitHub</a>
          <a href="#" class="text-white/40 hover:text-[#C1FF00] transition-colors uppercase text-xs font-bold italic">LinkedIn</a>
          <a href="https://instagram.com/mauricio.tsx" target="_blank" class="text-white/40 hover:text-[#C1FF00] transition-colors uppercase text-xs font-bold italic">Instagram</a>
        </div>
      </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between items-center pt-12 border-t border-white/5 gap-8">
      <div class="flex items-center gap-3">
        <div class="w-2 h-2 bg-[#C1FF00] rounded-full animate-pulse"></div>
        <span class="text-zinc-600 font-mono text-[10px] uppercase tracking-widest">
          © {new Date().getFullYear()} Mauricio Heredia • Rincón Digital
        </span>
      </div>

      <button 
        onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
        class="group flex items-center gap-4 text-zinc-500 hover:text-white transition-all"
      >
        <span class="text-[10px] font-black uppercase tracking-widest">Back to top</span>
        <div class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center group-hover:bg-[#C1FF00] group-hover:text-black transition-all group-hover:rotate-[-45deg]">
          <ArrowUp size={16} />
        </div>
      </button>
    </div>
  </div>

  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 w-[80vw] h-[80vw] bg-[#C1FF00]/5 blur-[120px] rounded-full pointer-events-none"></div>
</footer>